#!/bin/bash
# SPDX-License-Identifier: LGPL-2.1-or-later
set -e

if command -v authselect >/dev/null; then
    authselect select local
    authselect enable-feature with-systemd-homed
fi

if [[ -d /etc/pam.d ]]; then
    find /etc/pam.d -mindepth 1 -exec mv {} /usr/lib/pam.d \;
    rmdir /etc/pam.d
fi

# Get rid of obsolete stuff in the pam stack.
find /usr/lib/pam.d/ -mindepth 1 -exec sed --in-place '/pam_shells.so/d' {} \;
find /usr/lib/pam.d/ -mindepth 1 -exec sed --in-place '/pam_securetty.so/d' {} \;

# The profile ships userdb's AuthorizedKeysCommand in its generic SSH defaults.
# Its /etc/ssh/sshd_config.d link resolves into the read-only factory tree, so
# the upstream optional link rule must not create or relabel files through it.
rm -f /usr/lib/tmpfiles.d/20-systemd-userdb.conf

# Give ParticleOS its own identity/branding via os-release +
# issue. Note that we keep the original $ID, $VERSION and $VERSION_ID
# in place, so that we appear like the original underlying OS in most
# programmatic ways. However, all "pretty"/"fancy" strings now claim
# we are ParticleOS. Moreover, use $ID_LIKE to identify ParticleOs as
# such in a programmatic way.
(
    . /usr/lib/os-release
    cat >/usr/lib/os-release <<EOF
NAME="ParticleOS ($NAME Flavour)"
ID="$ID"
ID_LIKE="particleos-$ID"
PRETTY_NAME="ParticleOS/$NAME $VERSION"
FANCY_NAME="\033[0;38:2:252:186:3;1;49m⸭\033[0;38:2:252:186:3;49m ParticleOS/$NAME Flavour $VERSION\033[0m"
VERSION="$VERSION"
VERSION_ID="$VERSION_ID"
ANSI_COLOR="38:2:252:186:3;1;49"
ANSI_COLOR_REVERSE="48;2;252;186;3;1;30"
DEFAULT_HOSTNAME="particle-????-????"
HOME_URL="https://github.com/systemd/particleos/"
EOF

    cat >/usr/lib/issue <<EOF
\e[0;38:2:252:186:3;1;49m▒\e[0m \e[0;38:2:252:186:3;1;49m⸭\e[0;38:2:252:186:3;49m ParticleOS/$NAME Flavour $VERSION\e[0m
\e[0;38:2:252:186:3;1;49m▒\e[0m Kernel \r on an \m (\l)

EOF
)

# ParticleVE additions to ParticleOS's account/PAM and factory-configuration model.
set -euo pipefail
test -f /usr/lib/particleve/build.json
# Audit and SELinux remain enabled. Reproducible defaults are captured by upstream mkosi.finalize.
install -d /etc/selinux
cat >/etc/selinux/config <<'EOF'
SELINUX=enforcing
SELINUXTYPE=targeted
EOF
install -d /etc/systemd/zram-generator.conf.d
printf '# Deliberately empty: encrypted block swap backs zswap.\n' >/etc/systemd/zram-generator.conf
ln -s /dev/null /etc/systemd/zram-generator.conf.d/00-disable.conf
# No independent upstream transfer/installer/reset path may mutate the selected disk pair.
rm -rf /usr/lib/sysupdate.d /usr/lib/sysupdate.reboot.d /usr/lib/repart.d
install -d /usr/lib/sysupdate.d
ln -sf /dev/null /usr/lib/systemd/system/systemd-sysupdate.service
ln -sf /dev/null /usr/lib/systemd/system/systemd-sysupdate.timer
ln -sf /dev/null /usr/lib/systemd/system/systemd-sysupdate-reboot.service
ln -sf /dev/null /usr/lib/systemd/system/systemd-sysupdate-reboot.timer
ln -sf /dev/null /usr/lib/systemd/system/systemd-repart.service
systemctl preset-all
systemctl disable systemd-sysupdate-update.timer systemd-sysupdate-reboot.timer
# systemd-boot updates are exclusively installed by the two-disk coordinator.
ln -sf /dev/null /usr/lib/systemd/system/systemd-boot-update.service
# PAM is generated in the image; a boot-time authselect rewrite cannot update /usr.
ln -sf /dev/null /usr/lib/systemd/system/authselect-apply-changes.service
# Only configured links may obtain addresses; no generic DHCP fallback or trim job.
ln -sf /dev/null /usr/lib/systemd/network/89-ethernet.network
ln -sf /dev/null /usr/lib/systemd/system/fstrim.timer
# The factory directory is immutable. The public link needs the ordinary /etc
# link label; the target policy/configuration keeps its specific SELinux types.
printf '/etc/(selinux|audit) -l system_u:object_r:etc_t:s0\n' >>/etc/selinux/targeted/contexts/files/file_contexts.local
# Build the narrow EFI-write policy into the image, never the worker's kernel.
semodule --noreload --install /usr/lib/particleve/particleve_boot.cil
# Compile audit defaults before making the factory configuration read-only.
augenrules
# Capture the newly compiled policy and audit configuration in mkosi.finalize;
# packaged factory examples must not take precedence over the image's settings.
rm -rf /usr/share/factory/etc/selinux /usr/share/factory/etc/audit
# Keep the packaged SSH/PAM stack, adding only the required homed account gate.
# Root remains the independently accessible recovery/bootstrap account.
for stack in sshd system-auth password-auth; do
    test -f "/usr/lib/pam.d/$stack"
    sed -i '1i account requisite pam_exec.so quiet /usr/libexec/particleve-homed-account' "/usr/lib/pam.d/$stack"
done
# The configured /usr PAM stack is authoritative; the package's generic factory
# example must not shadow it when an installed writable root is initialized.
rm -rf /usr/share/factory/etc/pam.d
